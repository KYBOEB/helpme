# --- LLM: OpenAI-совместимый агрегатор (ProxyAPI) ---
LLM_BASE_URL=https://api.proxyapi.ru/v1
LLM_API_KEY=вставь_свой_ключ
LLM_MODEL_FAST=модель_для_классификации
LLM_MODEL_SMART=модель_для_ответа
# Модель эмбеддингов для поиска по базе знаний. Без неё поиск честно
# откатывается на чистый BM25 — приложение при этом работает.
LLM_MODEL_EMBED=text-embedding-3-small
# Сколько секунд ждать вектор запроса. Больше 4 ставить нельзя: браузер
# ждёт ответа 20 секунд, а кроме вектора в обращении есть ещё вызов модели.
LLM_EMBED_TIMEOUT=3.5

# --- поиск по базе знаний ---
# Готовый индекс эмбеддингов по карточкам (лежит в репозитории).
KB_EMB_INDEX=kb/emb_index.npz
# Кэш векторов запросов — переживает перезапуск, ускоряет повторные обращения.
KB_EMB_QUERIES=data/emb_queries.npz
# Если BM25 и так уверен (скор выше порога), за вектором в сеть не идём.
# 0 — ходить всегда. Значение подбирается прогоном tools/check_search.py.
KB_SKIP_VECTOR_SCORE=12
# Шаг длиннее этого числа символов считается подробным, и модель его
# не переписывает — экономит вызов на каждом попадании в базу знаний.
KB_DETAILED_STEP_CHARS=70
# ANSWER_REWRITE=1 возвращает прежнее поведение: переписывать шаги всегда.
ANSWER_REWRITE=0
# Карточки, добавленные оператором через панель.
KB_CUSTOM_DIR=data/kb_custom

# --- поведение диалога ---
CONFIDENCE_THRESHOLD=0.75
MAX_CLARIFYING_QUESTIONS=2
# Сколько нецелевых сообщений подряд терпим: первое — предупреждение,
# второе — закрытие обращения.
MAX_OFFTOPIC_MESSAGES=2

# --- панель оператора ---
# Логин демонстрационной учётной записи.
OPERATOR_LOGIN=operator
# Пароль либо открытым текстом, либо — предпочтительно — его sha256.
# Если задано OPERATOR_PASSWORD_SHA256, поле OPERATOR_PASSWORD не нужно.
OPERATOR_PASSWORD=придумай_пароль
OPERATOR_PASSWORD_SHA256=
SECRET_KEY=длинная_случайная_строка

# --- прочее ---
DB_PATH=data/helpme.db
DEMO_MODE=0
DEMO_CACHE_PATH=data/demo_cache.json
LLM_QUIRKS_PATH=data/llm_quirks.json
# Точность классификации из последнего прогона тест-набора — показывается
# в аналитике. Цифра из прогона, не из головы.
CLASSIFICATION_ACCURACY=0.95
WEBHOOK_URL=
